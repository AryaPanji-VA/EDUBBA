SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Optional Phase 7: preferred server-only secret key. Local development only.
# Leave empty until you manually run database/phase7-memory.sql.
SUPABASE_SECRET_KEY=
# Legacy fallback only, used when SUPABASE_SECRET_KEY is empty or missing.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy alternative only. Do not set this when using a publishable key.
# SUPABASE_ANON_KEY=your-legacy-anon-key-here

# AI provider (Phase 18): OpenRouter is the primary provider.
# Server only. Real values belong in .env.local. Never use NEXT_PUBLIC_.
OPENROUTER_API_KEY=
ROBIN_AI_MODEL=
ROBIN_AI_BASE_URL=https://openrouter.ai/api/v1
# NINEINFERENCE_API_KEY is legacy and no longer read by the runtime.

# Optional: diagnostic routes and ROBIN LAB are disabled in production by default.
ENABLE_DEV_TOOLS=false
